{
  "name": "bayframe",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.13.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.13.0",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "node scripts/db/stack.mts check && next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/db/stack.mts check && next start --hostname 127.0.0.1",
    "lint": "eslint src scripts tests drizzle.config.ts vitest.config.ts vitest.integration.config.ts playwright.config.ts eslint.config.mjs postcss.config.mjs --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:adopt": "node scripts/db/stack.mts adopt",
    "db:start": "node scripts/db/stack.mts start",
    "db:stop": "node scripts/db/stack.mts stop",
    "db:check": "node scripts/db/stack.mts check",
    "db:setup": "node scripts/db/setup.mts",
    "db:migrate": "node --env-file=.env.local scripts/db/migrate.mts",
    "db:verify": "node --env-file=.env.local scripts/db/verify.mts",
    "db:generate": "drizzle-kit generate",
    "auth:setup": "node scripts/auth/configure.mts",
    "demo:seed": "node --env-file=.env.local scripts/auth/seed.mts",
    "test:integration": "node --env-file=.env.local scripts/db/integration.mts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/server": "11.11.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "10.0.0-alpha.0",
    "@mui/material-nextjs": "9.5.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.31",
    "shadcn": "4.22.1",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
